# Secrets — never commit
.env
*.env

# Campaign layer — data, never code
# (licensed PDFs, character sheets, world state, adventure logs).
# Only the layout README is tracked.
campaigns/*
!campaigns/README.md

# No Python runtime needed (Hermes Bot Mode replaces it)
venv/
logs/
__pycache__/
*.pyc

# OS
.DS_Store
.history

# Local memory-store scratch
*.db
*.db-shm
*.db-wal
site/ --ignore
