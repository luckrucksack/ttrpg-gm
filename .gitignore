# Secrets — never commit
.env
*.env

# Campaign layer — everything under campaigns/ is data, never code
# (licensed PDFs, character sheets, world state, adventure logs).
# Only the layout README is tracked.
campaigns/*
!campaigns/README.md

# Runtime
venv/
logs/
__pycache__/
*.pyc
.DS_Store
.history

# Local memory-store scratch
*.db
*.db-shm
*.db-wal
