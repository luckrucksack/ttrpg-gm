# Secrets — never commit
.env
*.env

# Campaign layer — data, never code
# (licensed PDFs, character sheets, world state, adventure logs).
# Only the layout README is tracked.
campaigns/*
!campaigns/README.md

# No Python runtime needed (scripts run on the system python3)
venv/
logs/
__pycache__/
*.pyc

# Vendored patched bridge build — regenerate with: bash bridge/vendor/setup.sh
bridge/vendor/foundryvtt-mcp/

# OS
.DS_Store
.history

# Local memory-store scratch
*.db
*.db-shm
*.db-wal
# Pipeline output — extracted adventure data
pipeline/output/

# Mkdocs build output (regenerated by CI)
site/
